{
  "name": "Housefind (Playwright)",
  "image": "mcr.microsoft.com/playwright/python:v1.44.0-jammy",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python -m playwright install chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-playwright.playwright"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  },
  "remoteUser": "pwuser"
}
